      }
    },
    "The site answered with something unexpected.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The site answered with something unexpected."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сайт ответил неожиданным образом."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Seite hat unerwartet geantwortet."
          }
        }
      }
    },
    "The site did not say whether the post was made.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The site did not say whether the post was made."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сайт не сообщил, был ли пост отправлен."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Seite hat nicht gesagt, ob der Beitrag angekommen ist."
          }
        }
      }
    },
    "The site did not say whether the post went through.": {
      "extractionState": "manual",
      "localizations": {
