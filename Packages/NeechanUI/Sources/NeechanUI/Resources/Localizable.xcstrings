    "Neechan plays video through FFmpeg, built without any GPL component and used under the LGPL. The build script and the app's own source are available, so this app can be rebuilt against a modified FFmpeg." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neechan spielt Video über FFmpeg ab, das ohne jede GPL-Komponente gebaut und unter der LGPL verwendet wird. Das Build-Skript und der Quelltext der App sind verfügbar, sodass sie gegen ein verändertes FFmpeg neu gebaut werden kann."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neechan plays video through FFmpeg, built without any GPL component and used under the LGPL. The build script and the app's own source are available, so this app can be rebuilt against a modified FFmpeg."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neechan воспроизводит видео через FFmpeg, собранный без единого GPL-компонента и используемый по LGPL. Скрипт сборки и исходный код приложения открыты, поэтому его можно пересобрать с изменённым FFmpeg."
          }
        }
      }
    },
