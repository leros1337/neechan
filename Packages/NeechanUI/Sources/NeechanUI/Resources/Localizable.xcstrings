    },
    "WebM plays in this app but nowhere else on the phone: Photos will not accept one at all. Converting re-encodes the video, which takes a moment and loses a little quality." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WebM läuft in dieser App, sonst nirgends auf dem Telefon: Fotos nimmt es gar nicht erst an. Beim Umwandeln wird das Video neu kodiert, was einen Moment dauert und etwas Qualität kostet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WebM plays in this app but nowhere else on the phone: Photos will not accept one at all. Converting re-encodes the video, which takes a moment and loses a little quality."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WebM воспроизводится в этом приложении, но больше нигде на телефоне: «Фото» его вовсе не примут. Конвертация перекодирует видео — это занимает время и немного ухудшает качество."
          }
        }
      }
    },
    "Welcome to Neechan" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Willkommen bei Neechan"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Welcome to Neechan"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добро пожаловать в Neechan"
          }
        }
      }
    },
    "What is wrong with this post?" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was stimmt mit diesem Beitrag nicht?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What is wrong with this post?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Что не так с этим постом?"
          }
        }
      }
    },
    "What it says" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was darin steht"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What it says"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Что написано"
          }
        }
      }
    },
    "With this off, every thumbnail is blurred until you tap it." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn das aus ist, ist jede Miniatur unscharf, bis du sie antippst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With this off, every thumbnail is blurred until you tap it."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда выключено, каждая миниатюра размыта до нажатия."
          }
        }
      }
    },
    "You" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы"
          }
        }
      }
    },
    "You can hide any post or thread, and autohide rules keep chosen posters, words and patterns out of your feed. Hidden posts stay hidden until you reveal them, and nothing you hide is shown to you again." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst jeden Beitrag und jeden Thread ausblenden, und Autohide-Regeln halten ausgewählte Poster, Wörter und Muster aus deinem Feed. Ausgeblendetes bleibt ausgeblendet, bis du es selbst wieder einblendest."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can hide any post or thread, and autohide rules keep chosen posters, words and patterns out of your feed. Hidden posts stay hidden until you reveal them, and nothing you hide is shown to you again."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы можете скрыть любой пост или тред, а правила автоскрытия уберут из ленты выбранных авторов, слова и шаблоны. Скрытые посты остаются скрытыми, пока вы сами их не раскроете."
          }
        }
      }
    },
    "You must be at least 18 years of age to use this application. By agreeing, you confirm that you are 18 or older." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du musst mindestens 18 Jahre alt sein, um diese App zu verwenden. Mit deiner Zustimmung bestätigst du, dass du 18 oder älter bist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You must be at least 18 years of age to use this application. By agreeing, you confirm that you are 18 or older."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вам должно быть не менее 18 лет, чтобы пользоваться этим приложением. Соглашаясь, вы подтверждаете, что вам есть 18."
          }
        }
      }
    },
    "You will be signed out of your passcode and asked your age again." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du wirst von deinem Passcode abgemeldet und erneut nach deinem Alter gefragt."
          }
