    "With this off, every thumbnail is blurred until you tap it.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With this off, every thumbnail is blurred until you tap it."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда выключено, каждая миниатюра размыта до нажатия."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn das aus ist, ist jede Miniatur unscharf, bis du sie antippst."
          }
        }
      }
    },
    "You": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You"
          }
        },
        "ru": {
          "stringUnit": {
